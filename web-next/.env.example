# URL do back FastAPI (usado pelos route handlers em app/api/* para proxiar).
# Em produção o reverse proxy (nginx/Caddy) deve fazer essa ponte.
BACKEND_URL=http://127.0.0.1:8000

# URL base público da API (NÃO usado em dev; só se quiser chamar o back direto).
NEXT_PUBLIC_API_BASE=

# PORT (padrão do Next.js — `next dev`/`next start` já a definem sozinhos
# quando a porta default 3000 está ocupada). lib/api.ts usa PORT para montar
# a URL base de SSR self-referencial (http://127.0.0.1:$PORT) quando
# NEXT_PUBLIC_API_BASE não está setado — não precisa configurar manualmente,
# só documentado aqui porque afeta o contrato de lib/api.ts.
# PORT=3000

# URL pública do site, usada em metadados/SEO (robots.txt, sitemap.xml, OpenGraph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000