# Diretorio do cache SQLite
BUSCA_GO_DATA_DIR=./data

# TTL do cache em dias (padrao 7)
BUSCA_GO_CACHE_DAYS=7

# Timeout do Playwright em ms (padrao 30s)
BUSCA_GO_TIMEOUT_MS=30000

# Headless (padrao true; mude para false so para debug visual)
BUSCA_GO_HEADLESS=true

# Porta do servidor web local (padrao 8000)
BUSCA_GO_PORT=8000

# --- Agente investigador (OpenRouter, cabeca/worker -- P4) ---
# Sem OPENROUTER_API_KEY, POST /api/casos/{id}/investigar responde 400.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_CABECA=google/gemini-3-flash-preview
OPENROUTER_MODEL_WORKER=deepseek/deepseek-v4-flash
AGENTE_MAX_SUBTAREFAS=20
AGENTE_MAX_ITER_WORKER=8
AGENTE_TETO_TOKENS=1000000
AGENTE_TETO_TEMPO_S=1800